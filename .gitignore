# --- BACKEND (Python/Flask) ---
# Ignora pastas de ambiente virtual (independente do nome)
backend/venv/
backend/.venv/
backend/env/
venv/

# Ignora cache do Python
backend/**/__pycache__/
backend/**/*.py[cod]
*.pyc

# Ignora o Banco de Dados (Protege os dados dos alunos e senhas)
backend/*.db
backend/*.db-journal
backend/*.sqlite3
*.db
*.sqlite3

# Ignora fotos enviadas (mantém a pasta mas ignora os arquivos)
backend/uploads/*
!backend/uploads/.gitkeep

# --- FRONTEND (React/Vite/Node) ---
# Ignora a pasta de bibliotecas (muito pesada)
frontend/node_modules/
node_modules/

# Ignora arquivos de compilação/distribuição
frontend/dist/
frontend/dist-ssr/
frontend/build/

# Ignora variáveis de ambiente (contém chaves de API e segredos)
frontend/*.local
.env
.env.local

# --- LOGS E ERROS ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- SISTEMA E EDITORES (IDE) ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.bak

# Ignora todo o conteúdo da pasta de fotos, mas mantém a pasta se houver um .gitkeep
backend/uploads/*
backend/uploads/*
!**/uploads/.gitkeep